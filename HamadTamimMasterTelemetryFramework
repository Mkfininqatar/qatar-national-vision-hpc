        """
        print(f"[*] DIAGNOSING INCIDENT: {self.incident_id} FOR WORKER: {self.worker_id}")
        
        modules = system_audit_report.get("module_reports", {})
        recovery_plan = []

        # ১. ভিসা ও ব্রোকার এক্সপ্লোইটেশন ফল্ট পয়েন্ট চেক
