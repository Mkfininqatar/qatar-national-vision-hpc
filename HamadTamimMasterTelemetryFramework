                "severity": "HIGH_EMERGENCY",
                "recovery_action": "Dispatch cooling alert to wearable, mandate immediate shade break, notify field safety officer."
            })

        # ৩. বায়ো-মেট্রিক বা কার্ডিওভাসকুলার স্ট্রেস ফল্ট পয়েন্ট চেক
        bio_risk = modules.get("biometric_telemetry", {}).get("physiological_risk", "")
        if "CRITICAL" in bio_risk:
            recovery_plan.append({
                "problem_point": "Elevated Core Temp & Blood Pressure Spike",
                "severity": "EMERGENCY_MEDICAL",
                "recovery_action": "Trigger automated medical evacuation protocol, dispatch hydration & medical unit."
            })

        # ৪. ফিনান্সিয়াল ওয়েজ ডিলে বা মজুরি চুরি ফল্ট পয়েন্ট চেক
        fin_status = modules.get("financial_dignity", {}).get("audit_result", "")
        if "CRITICAL" in fin_status:
            recovery_plan.append({
                "problem_point": "Wage Delay / Financial Torture Detected",
                "severity": "CRITICAL_LEGAL",
                "recovery_action": "Freeze employer's digital payroll clearance, initiate automatic wage compensation from escrow."
            })

        self.recovery_actions = recovery_plan
        return {
            "incident_id": self.incident_id,
            "total_problem_points_marked": len(recovery_plan),
            "recovery_execution_plan": recovery_plan
        }

