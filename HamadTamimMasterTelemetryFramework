            await writer.wait_closed()

    async def _process_verified_global_payload(self, payload: dict, verified_flag: int, writer: asyncio.StreamWriter):
        source_node = payload.get("node_id", "UNKNOWN_GLOBAL_NODE")
        directive_code = payload.get("directive_code", "CODE-13")
        incoming_risk = float(payload.get("air_risk", 0.0))
        timestamp = datetime.utcnow().isoformat()

        log_global(self.node_id, f"Processed verified packet from [{source_node}] -> Risk Index: {incoming_risk}")

        # Update cluster node status & heartbeat
        if source_node in self.cluster_registry:
            self.cluster_registry[source_node].last_heartbeat = timestamp
            self.cluster_registry[source_node].air_risk_index = incoming_risk
            self.cluster_registry[source_node].is_active = True

        # Cross-Node Trigger Threshold Evaluation & Automated Failover Logic
        if incoming_risk > 0.85:
            log_global(self.node_id, f"GLOBAL THREAT ALERT from {source_node}! Risk {incoming_risk} > 0.85. Elevating defensive posture.", level="WARNING")
            self.current_risk_index = max(self.current_risk_index, incoming_risk)
            self.system_status = "DEFENSIVE_SHIELD_ELEVATED_GLOBAL"

        # Record ACID persistent audit log
        self.db.record_metrics(
            timestamp=timestamp,
            node_id=source_node,
            directive_code=directive_code,
            air_risk=incoming_risk,
            status=self.system_status,
            verified=verified_flag,
            payload=json.dumps(payload)
        )

        # Send encrypted acknowledgement back
        response_payload = {
            "ack": True,
            "responder_node": self.node_id,
            "global_risk_index": self.current_risk_index,
            "system_status": self.system_status,
            "timestamp": timestamp
        }
        resp_bytes = json.dumps(response_payload, sort_keys=True).encode('utf-8')
        resp_hmac = self.security.generate_hmac_token(resp_bytes)
        
        final_response = {
            "hmac_signature": resp_hmac,
            "payload": response_payload
        }
        writer.write((json.dumps(final_response) + "\n").encode('utf-8'))
        await writer.drain()

    async def monitor_node_failover(self):
        """
        Automated failover algorithm: checks heartbeat of cluster nodes. If a primary 
        node drops offline, instantly reassigns tasks and triggers failover protocol.
        """
        while True:
            await asyncio.sleep(15)
            now = datetime.utcnow()
            for node_id, profile in self.cluster_registry.items():
                last_seen = datetime.fromisoformat(profile.last_heartbeat)
                delta_seconds = (now - last_seen).total_seconds()
                
                if delta_seconds > 45 and profile.is_active:
                    profile.is_active = False
                    log_global(self.node_id, f"FAILOVER ALERT: Primary node {node_id} unresponsive for {delta_seconds:.1f}s. Reassigning sovereign routing!", level="ERROR")
                    self.system_status = f"FAILOVER_ACTIVATED_DROPPED_{node_id}"

    async def start_global_server(self):
        server = await asyncio.start_server(
            self.handle_node_connection, self.host, self.port
        )
        log_global(self.node_id, f"Hamad-Tamim Global Dignity & Telemetry Server active on {self.host}:{self.port}")
        
        # Run background failover monitoring task concurrently
        asyncio.create_task(self.monitor_node_failover())

        async with server:
            await server.serve_forever()


