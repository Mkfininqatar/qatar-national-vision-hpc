    if not qid or not company_name or not violation_type:
        return jsonify({"error": "Missing critical verification parameters (QID/Company/Type)"}), 400

    grievance_case = {
        "case_id": f"GLIDSF-CASE-{len(GRIEVANCE_REGISTRY) + 1001}",
