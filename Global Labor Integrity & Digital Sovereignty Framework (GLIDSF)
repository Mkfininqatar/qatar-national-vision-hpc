@app.route('/api/v1/audit-quota', methods=['POST'])
def audit_quota():
    """
    Forensic Audit Simulation:
    Validates company quota utilization vs 12-month Entry/Exit logs.
    """
    data = request.json
    company_id = data.get('company_id')
    allocated_quotas = data.get('allocated_quotas', 0)
    active_workers = data.get('active_workers', 0)

    diverision_rate = ((allocated_quotas - active_workers) / allocated_quotas) * 100 if allocated_quotas > 0 else 0
    
    is_black_market = diversion_rate > 30  # If more than 30% quota is unaccounted for

    return jsonify({
        "company_id": company_id,
        "allocated_quotas": allocated_quotas,
        "active_workers": active_workers,
        "diversion_percentage": round(diversion_rate, 2),
        "black_market_status": "FLAGGED FOR LICENSE REVOCATION" if is_black_market else "COMPLIANT",
        "action_required": "Instant Fine & Quota Freeze" if is_black_market else "None"
    })


