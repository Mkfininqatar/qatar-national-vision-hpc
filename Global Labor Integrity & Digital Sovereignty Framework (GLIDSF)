            "company_name": company_name,
            "allocated_quotas": allocated_quotas,
            "active_ground_workers": active_ground_workers,
            "entry_exit_logs": entry_exit_logs,
            "last_audited": datetime.utcnow().isoformat()
        }

    def evaluate_quota_integrity(self, company_id, diversion_threshold_percentage=30.0):
        """
        Executes forensic audit comparing allocated quotas vs. active ground workforce 
        and 12-month movement logs to detect black market visa-selling rings.
        """
        if company_id not in self.company_registry:
            return {"error": "Company ID not found in the sovereign registry."}

        data = self.company_registry[company_id]
        allocated = data["allocated_quotas"]
        active = data["active_ground_workers"]
        logs = data["entry_exit_logs"]

        # Calculate unaccounted or diverted workforce (potential free-visa black market)
        unaccounted_workers = allocated - active
        diversion_rate = (unaccounted_workers / allocated) * 100 if allocated > 0 else 0

        # Forensic Audit Rule: If diversion exceeds threshold or log inconsistency is found
        is_black_market = diversion_rate > diversion_threshold_percentage

        audit_result = {
            "company_id": company_id,
            "company_name": data["company_name"],
            "allocated_quotas": allocated,
            "active_ground_workers": active,
            "unaccounted_diversion_count": unaccounted_workers,
            "diversion_percentage": round(diversion_rate, 2),
            "audit_timestamp": datetime.utcnow().isoformat(),
            "status": "FLAGGED: VISA/QUOTA BLACK MARKET DETECTED" if is_black_market else "COMPLIANT",
            "enforcement_action": (
                "INSTANT QUOTA FREEZE, LICENSE SUSPENSION & AUTOMATED PENALTY"
                if is_black_market 
                else "NO ACTION REQUIRED"
            )
        }

        return audit_result


