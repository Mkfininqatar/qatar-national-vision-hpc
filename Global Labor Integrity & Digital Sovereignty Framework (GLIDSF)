@app.route('/api/v1/report-violation', methods=['POST'])
def report_violation():
    """
    Direct-to-State Digital Grievance Mechanism:
    Allows any worker with a QID/Metrash integration to report wage non-compliance 
    or quota diversion instantly.
    """
    data = request.json
    qid = data.get('qid')
    company_name = data.get('company_name')
    violation_type = data.get('violation_type') # e.g., 'Underpaid', 'Absconding Fraud', 'No PPE'
