class HamadTamimGlobalDignityCore:
    def __init__(self, bilateral_agreement_id, worker_id, source_country, destination_country):
        self.agreement_id = bilateral_agreement_id
        self.worker_id = worker_id
        self.source_country = source_country
        self.destination_country = destination_country
        self.contract_status = "PENDING_VERIFICATION"
        self.telemetry_logs = []

    def verify_bilateral_contract(self, promised_salary, actual_salary, broker_fee):
        """
        যাচাই করে যে ভিসা প্রসেসিং বা চুক্তিতে কোনো কারচুপি বা অবৈধ ফি আছে কি না।
        কোনো শ্রেণিভেদ ছাড়াই প্রতিটি শ্রমিকের জন্য এটি সমানভাবে প্রযোজ্য।
        """
        print(f"[*] Verifying G2G Contract for Worker ID: {self.worker_id} between {self.source_country} and {self.destination_country}...")
        
        # জিরো-এক্সপ্লোইটেশন চেক: অবৈধ ব্রোকার ফি বা বেতন গরমিল যাচাই
        if broker_fee > 0:
            self.contract_status = "REJECTED_EXPLOITATION_DETECTED"
            return {
                "status": "FLAGGED",
                "message": "System Alert: Broker fee detected! Violation of zero-exploitation policy."
            }
        
        if promised_salary != actual_salary:
            self.contract_status = "REJECTED_SALARY_MISMATCH"
            return {
                "status": "FLAGGED",
                "message": "System Alert: Salary mismatch detected between source and destination terms."
            }
        
        self.contract_status = "VERIFIED_SECURE"
        return {
            "status": "APPROVED",
            "message": "Contract validated successfully under Hamad-Tamim Global Dignity Standards."
        }

    def log_telemetry_metrics(self, gps_coordinates, ambient_temp_celsius, is_mock_location):
        """
        রিয়েল-টাইম টেলিমেট্রি, থার্মাল সেফটি এবং অ্যান্টি-স্পুফিং ডিটেকশন।
        """
        timestamp = datetime.utcnow().isoformat()
        
        # অ্যান্টি-স্পুফিং এবং মক লোকেশন চেক
        if is_mock_location:
            security_alert = "HIGH_RISK: Mock location detected. Potential boundary spoofing."
        else:
            security_alert = "SECURE: Physical boundary verified."

        # থার্মাল হিট স্ট্রেস চেক (যেমন: তাপমাত্রা যদি ৪৫ ডিগ্রি সেলসিয়াসের বেশি হয়)
        heat_warning = True if ambient_temp_celsius >= 45.0 else False

        telemetry_entry = {
            "timestamp": timestamp,
            "worker_id": self.worker_id,
            "gps": gps_coordinates,
            "temperature": ambient_temp_celsius,
            "security_status": security_alert,
            "heat_stress_warning": heat_warning
        }

        self.telemetry_logs.append(telemetry_entry)
        return telemetry_entry

