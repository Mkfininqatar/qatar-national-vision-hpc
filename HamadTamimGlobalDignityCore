class VisaBrokerExploitationShield:
    def __init__(self, visa_id, processing_agency, destination_country):
        self.visa_id = visa_id
        self.processing_agency = processing_agency
        self.destination_country = destination_country

    def audit_agency_processing_integrity(self, official_visa_cost, charged_amount_to_worker, commission_broker_involved, has_hidden_fees):
        """
        ট্রাভেল এজেন্সি এবং মধ্যস্বত্বভোগীদের কমিশন চক্র, ভিসা গিল্টি এবং অতিরিক্ত অর্থ আদায়ের 
        প্রতারণা শনাক্ত করে। এটি কোনো অবস্থাতেই সাধারণ শ্রমিককে শোষণের সুযোগ দেয় না।
        """
        fraud_status = "LEGITIMATE_G2G_PROCESS"
        system_verdict = "APPROVED"
        exploitation_risk = "ZERO"

        # ১. অতিরিক্ত ফি বা কমিশন চার্জ চেক (ভিসা গিল্টি/প্রতারণা)
        if charged_amount_to_worker > official_visa_cost or commission_broker_involved:
            fraud_status = "CRITICAL_BROKER_EXPLOITATION_DETECTED"
            system_verdict = "REJECTED_AND_BLACKLIST_AGENCY"
            exploitation_risk = "HIGH_FRAUD_TRAP"

        # ২. লুকানো ফি বা জালিয়াতির চুক্তি চেক
        if has_hidden_fees:
            fraud_status = "HIDDEN_FEE_SCAM_DETECTED"
            system_verdict = "BLOCK_VISA_ISSUANCE"
            exploitation_risk = "SEVERE"

        return {
            "visa_id": self.visa_id,
            "agency_name": self.processing_agency,
            "official_cost": official_visa_cost,
            "charged_to_worker": charged_amount_to_worker,
            "broker_commission_detected": commission_broker_involved,
            "fraud_audit_status": fraud_status,
            "verdict": system_verdict,
            "exploitation_risk_level": exploitation_risk
        }

