class PeakHoursThermalSafetyEngine:
    def __init__(self, worker_id, region_climate_profile="Middle_East_Desert"):
        self.worker_id = worker_id
        self.climate_profile = region_climate_profile

    def evaluate_outdoor_risk(self, current_hour, ambient_temp_celsius, is_direct_sunlight):
        """
        সকাল ১১টা থেকে দুপুর ৩টা (11:00 - 15:00) পর্যন্ত রোদের তীব্রতা এবং তাপপ্রবাহ 
        যাচাই করে রিয়েল-টাইম রিস্ক লেভেল নির্ধারণ করে। 
        কোনো শ্রেণিভেদ ছাড়াই সকল শ্রমিকের জন্য এই প্রটেকশন সমানভাবে কার্যকর থাকবে।
        """
        # পিক আওয়ার বা সর্বোচ্চ রৌদ্রোজ্জ্বল সময় নির্ধারণ (সকাল ১১টা থেকে দুপুর ৩টা)
        is_peak_sun_hours = 11 <= current_hour < 15

        risk_status = "SAFE"
        action_required = "NORMAL_OPERATION"

        if is_peak_sun_hours and is_direct_sunlight:
            if ambient_temp_celsius >= 40.0:
                risk_status = "CRITICAL_HAZARD"
                action_required = "IMMEDIATE_WORK_HALT_AND_SHADE_REQUIRED"
            else:
                risk_status = "HIGH_HEAT_RISK"
                action_required = "MANDATORY_HYDRATION_AND_MONITORING"
        elif ambient_temp_celsius >= 45.0:
            risk_status = "EXTREME_TEMPERATURE_WARNING"
            action_required = "HEAT_STRESS_PRECAUTION_ACTIVATED"

        return {
            "worker_id": self.worker_id,
            "current_hour": f"{current_hour}:00",
            "temperature_celsius": ambient_temp_celsius,
            "peak_hours_active": is_peak_sun_hours,
            "risk_level": risk_status,
            "system_action": action_required
        }

# টেস্ট রান: সকাল সাড়ে ১১টার রোদের তীব্রতা ও তাপমাত্রা যাচাই
if __name__ == "__main__":
    thermal_engine = PeakHoursThermalSafetyEngine(worker_id="WRK-88210")
    
    # ধরে নিই বর্তমান সময় বেলা ১১:৩০ টা এবং তাপমাত্রা ৪৭ ডিগ্রি সেলসিয়াস
    evaluation = thermal_engine.evaluate_outdoor_risk(
        current_hour=11.5, 
        ambient_temp_celsius=47.0, 
        is_direct_sunlight=True
    )
    print("Thermal Safety Evaluation:", evaluation)
class BioTelemetryStressEngine:
    def __init__(self, worker_id):
        self.worker_id = worker_id

    def evaluate_physiological_stress(self, core_temp_f, heart_rate_bpm, bp_systolic, bp_diastolic, exposure_duration_mins):
        """
        শ্রমিকের শরীরের তাপমাত্রা, হৃদস্পন্দন এবং রক্তচাপের তারতম্য বিশ্লেষণ করে 
        তাপজনিত স্বাস্থ্যঝুঁকি (Heat Stress & Cardiovascular Risk) মূল্যায়ন করে।
        """
        risk_level = "NORMAL"
        medical_action = "STABLE_CONDITION"
        
        # ১. শরীরের তাপমাত্রা চেক (যেমন: ১০৪-১০৬° ফারেনহাইট বা তার বেশি হলে ক্রিটিক্যাল)
        if core_temp_f >= 104.0:
            risk_level = "CRITICAL_HEAT_STROKE_RISK"
            medical_action = "EMERGENCY_EVACUATION_AND_COOLING_REQUIRED"
        elif core_temp_f >= 101.5:
            risk_level = "HIGH_THERMAL_STRAIN"
            medical_action = "MANDATORY_REST_IN_SHADE"

        # ২. রক্তচাপ ও হৃদস্পন্দন চেক (স্বাভাবিক: ১২০/৮০, উচ্চঝুঁকি: ১৪০/৯০+)
        if bp_systolic >= 140 or bp_diastolic >= 90:
            if risk_level != "CRITICAL_HEAT_STROKE_RISK":
                risk_level = "HYPERTENSIVE_HEAT_STRAIN"
            medical_action = "IMMEDIATE_BLOOD_PRESSURE_AND_HYDRATION_CHECK"

        # ৩. দীর্ঘসময় ধরে উচ্চ ঝুঁকিতে থাকার প্রভাব (Long-term chronic risk accumulation)
        if exposure_duration_mins > 90 and risk_level in ["HIGH_THERMAL_STRAIN", "HYPERTENSIVE_HEAT_STRAIN"]:
            medical_action = "CHRONIC_ORGAN_DAMAGE_WARNING_STOP_WORK"

        return {
            "worker_id": self.worker_id,
            "estimated_core_temp_f": core_temp_f,
            "heart_rate": heart_rate_bpm,
            "blood_pressure": f"{bp_systolic}/{bp_diastolic} mmHg",
            "exposure_duration_mins": exposure_duration_mins,
            "physiological_risk": risk_level,
            "recommended_system_action": medical_action
        }

# টেস্ট রান: অতিরিক্ত গরমে শ্রমিকের শারীরিক অবস্থা যাচাই
if __name__ == "__main__":
    bio_engine = BioTelemetryStressEngine(worker_id="WRK-88210")
    
    # ধরে নিই কর্মীর শরীরের তাপমাত্রা ১০৫°F, হার্টবিট বেশি এবং রক্তচাপ ১৪২/৯৫ mmHg
    stress_eval = bio_engine.evaluate_physiological_stress(
        core_temp_f=105.2, 
        heart_rate_bpm=125, 
        bp_systolic=142, 
        bp_diastolic=95, 
        exposure_duration_mins=120 # ২ ঘণ্টা ধরে রোদে অবস্থান
    )
    
    print("Bio-Telemetry Stress Evaluation Result:")
    for key, value in stress_eval.items():
        print(f"  - {key}: {value}")
class FinancialDignityDisbursementEngine:
    def __init__(self, worker_id, employer_id):
        self.worker_id = worker_id
        self.employer_id = employer_id

    def audit_salary_disbursement(self, scheduled_pay_date, actual_pay_date, contracted_amount, disbursed_amount, delay_days):
        """
        শ্রমিকের মাসিক বেতন এবং পাওনা নির্দিষ্ট সময়ে পরিশোধ হচ্ছে কি না তা অডিট করে।
        দীর্ঘমেয়াদি মানসিক চাপ ও আর্থিক শোষণ রোধে এটি শতভাগ সময়মতো পেমেন্ট নিশ্চিত করে।
        """
        audit_status = "COMPLIANT"
        system_action = "SALARY_SECURED_AND_VERIFIED"
        psychological_stress_risk = "LOW"

        # ১. পেমেন্টে দেরি বা ডিলে চেক (নির্দিষ্ট সময়ের মধ্যে পেমেন্ট নিশ্চিত করা)
        if delay_days > 5:
            audit_status = "NON_COMPLIANT_DELAYED_PAY"
            system_action = "FLAG_EMPLOYER_FOR_FINANCIAL_BREACH"
            psychological_stress_risk = "HIGH_DUE_TO_FINANCIAL_UNCERTAINTY"

        # ২. বেতনের পরিমাণে গরমিল বা কম দেওয়ার জালিয়াতি চেক
        if disbursed_amount < contracted_amount:
            audit_status = "CRITICAL_WAGE_THEFT_DETECTED"
            system_action = "AUTOMATED_G2G_PENALTY_AND_RESTITUTION_TRIGGER"
            psychological_stress_risk = "CRITICAL_MENTAL_DISTRESS_HAZARD"

        return {
            "worker_id": self.worker_id,
            "employer_id": self.employer_id,
            "scheduled_date": scheduled_pay_date,
            "actual_date": actual_pay_date,
            "delay_days": delay_days,
            "contracted_amount": contracted_amount,
            "disbursed_amount": disbursed_amount,
            "audit_result": audit_status,
            "stress_risk_level": psychological_stress_risk,
            "enforced_action": system_action
        }

# টেস্ট রান: শ্রমিকের মাসিক বেতন ডিসবার্সমেন্ট ও মানসিক চাপ অডিট
